  {
    "name": "place_order",
    "title": "Place crypto order",
    "description": "Places a REAL crypto order with real money. With confirm=false (the default) nothing is sent: it validates the order and returns a preview with the estimated USD notional. Show that preview to the user and only call again with confirm=true after they explicitly approve it. Orders above $50 estimated notional are refused, as are pairs other than BTC-USD.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "description": "Pair such as BTC-USD"
        },
        "side": {
          "type": "string",
          "enum": [
            "buy",
            "sell"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "market",
            "limit",
            "stop_loss",
            "stop_limit"
          ]
        },
        "asset_quantity": {
          "description": "Amount of the asset. Exactly one of asset_quantity or quote_amount.",
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "quote_amount": {
          "description": "Amount in USD. Not allowed for market orders.",
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "limit_price": {
          "description": "Required for limit and stop_limit",
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "stop_price": {
          "description": "Required for stop_loss and stop_limit",
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "time_in_force": {
          "description": "Required for stop_loss and stop_limit; optional for limit",
          "type": "string",
          "enum": [
            "gtc",
            "gfd",
            "gfw",
            "gfm"
          ]
        },
        "client_order_id": {
          "description": "Idempotency key; generated if omitted. Reuse it when retrying.",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "confirm": {
          "default": false,
          "description": "false = preview only; true = send the order",
          "type": "boolean"
        }
      },
      "required": [
        "symbol",
        "side",
        "type"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
