  {
    "name": "get_estimated_price",
    "title": "Get estimated price",
    "description": "Estimated execution price for the given quantities. Use side \"ask\" for buys and \"bid\" for sells.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "description": "Pair such as BTC-USD"
        },
        "side": {
          "type": "string",
          "enum": [
            "bid",
            "ask",
            "both"
          ]
        },
        "quantities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
          },
          "description": "One or more asset quantities"
        }
      },
      "required": [
        "symbol",
        "side",
        "quantities"
      ]
    },
