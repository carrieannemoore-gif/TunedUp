# Copy to .env and fill in. NEVER commit .env.

# Robinhood Crypto Trading API credentials (create at robinhood.com -> Account -> Settings -> Crypto API).
RH_API_KEY=
# Base64-encoded ED25519 private key (32-byte seed) whose public key you registered with Robinhood.
RH_PRIVATE_KEY_B64=

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# paper (default, simulated) or live (real money).
TRADING_MODE=paper
# Live trading requires BOTH TRADING_MODE=live AND this exact value.
I_ACCEPT_LIVE_TRADING_RISK=no
