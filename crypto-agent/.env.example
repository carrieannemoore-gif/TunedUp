# Copy to .env and fill in. NEVER commit .env.

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# paper (default, simulated) or live (real money).
TRADING_MODE=paper
# Live trading requires BOTH TRADING_MODE=live AND this exact value.
I_ACCEPT_LIVE_TRADING_RISK=no

# --- Your robinhood-crypto-mcp server (live_broker: mcp, transport: stdio) ---
# Passed ONLY to the MCP server process the agent starts. Create the key pair with the server's
# `npm run keygen`, register the public key in Robinhood, and give the credential trading permission.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_BASE64=
# The server's own hard cap per order, in USD. Required for live trading. Set it at or above
# allowance_usd x max_order_pct / 100, otherwise the server will refuse the agent's larger orders.
RH_MAX_ORDER_NOTIONAL_USD=

# --- Only for live_broker: rest (direct API, no MCP server) ---
RH_API_KEY=
RH_PRIVATE_KEY_B64=
